{
	"plugins": [
		{
			"name": "Footnotes",
			"className": "Footnotes",
			"description": "Introduces footnotes functionality for adding references and notes.",
			"docs": "features/footnotes.html",
			"path": "src/footnotes.ts",
			"uiComponents": [
				{
					"name": "insertFootnote",
					"type": "Button",
					"iconName": "IconFootnote"
				}
			],
			"htmlOutput": [
				{
					"elements": "sup",
					"classes": "footnote"
				},
				{
					"elements": "a",
					"classes": "footnote-backlink",
					"attributes": "href"
				},
				{
					"elements": "ol",
					"classes": "footnotes"
				},
				{
					"elements": "li",
					"classes": "footnote-definition",
					"attributes": "id"
				},
				{
					"elements": "div",
					"classes": "footnote-content"
				}
			]
		},
		{
			"name": "Footnotes Properties",
			"className": "FootnotesProperties",
			"description": "Provides the ability to customize footnote properties such as numbering style.",
			"docs": "features/footnotes.html#footnote-properties",
			"path": "src/footnotesproperties.ts",
			"uiComponents": [
				{
					"type": "Button",
					"name": "footnotesStyle",
					"label": "Footnote Style",
					"iconName": "IconFootnote"
				}
			],
			"htmlOutput": [
				{
					"elements": "ol",
					"classes": "footnotes",
					"styles": "list-style-type",
					"attributes": "type"
				}
			]
		}
	]
}
